{
  "name": "deadlock.backend",
  "version": "0.1.0",
  "description": "Deadlock Backend",
  "private": false,
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.13",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^11.0.13",
    "@types/node": "^22.9.3",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-steam": "^1.0.18",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "stripe": "^17.4.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.22",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-steam": "^1.0.6",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
