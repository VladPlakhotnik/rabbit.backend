{
  "name": "deadlock.backend",
  "version": "0.1.0",
  "description": "Deadlock Backend",
  "private": false,
  "scripts": {
    "prestart": "yarn build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "postinstall": "yarn build",
    "sync:csgo": "ts-node --transpile-only scripts/sync-prices-once.ts",
    "sync:dota": "ts-node --transpile-only scripts/sync-dota-prices-once.ts",
    "sync:csgo:catalog": "ts-node --transpile-only scripts/sync-csgo-catalog-once.ts",
    "sync:dota:catalog": "ts-node --transpile-only scripts/sync-dota-catalog-once.ts",
    "sync:csgo:class-instance": "ts-node --transpile-only scripts/sync-csgo-class-instance-once.ts",
    "sync:dota:class-instance": "ts-node --transpile-only scripts/sync-dota-class-instance-once.ts",
    "clicker:redis:clear": "ts-node --transpile-only scripts/clear-clicker-redis.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.9.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-steam": "^1.0.6",
    "axios": "^1.15.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cache-manager": "^7.2.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.5.4",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-steam": "^1.0.18",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stream-json": "^2.1.0",
    "stripe": "^17.4.0",
    "ts-node": "^10.9.2",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.22",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/speakeasy": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "nodemon": "^3.1.7"
  },
  "resolutions": {
    "axios": "^1.15.0",
    "socket.io-parser": "^4.2.6",
    "qs": "^6.14.2",
    "follow-redirects": "^1.16.0",
    "jws": "^4.0.1",
    "tar": "^7.5.7"
  }
}
