# Backend environment variables.
# Copy this file to `.env` and fill real values locally.
# Never commit a populated `.env`.

# Core
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Comma-separated allowlist, no trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost,https://localhost:443

# Data stores
DATABASE_URL=postgres://user:password@localhost:5432/rabbit
REDIS_URL=redis://localhost:6379

# Game-user JWT secrets. Use different values for access and refresh.
# Example generator:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_64_random_hex_chars
JWT_REFRESH_SECRET=replace_me_different_64_random_hex_chars

# Admin auth
ADMIN_JWT_ACCESS_SECRET=replace_me_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=replace_me_admin_refresh_secret
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=ChangeMeNow!2026
BCRYPT_ROUNDS=12
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_MAX_FAILED_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION_MS=900000
ADMIN_REFRESH_COOKIE_NAME=admin_rt

# Steam
STEAM_API_KEY=replace_me

# Markets and pricing
MARKET_CSGO_API_KEY=replace_me
MARKET_DOTA2_API_KEY=replace_me
SKIN_PRICE_MARKUP=0

# Payments
STRIPE_SECRET_KEY=sk_test_replace_me

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHANNEL_CHAT_ID=replace_me
TELEGRAM_SUBSCRIPTION_BONUS_AMOUNT=0.50

# Scheduled jobs and bots
DISABLE_BOTS=false
DISABLE_MINES_BOTS=false
DISABLE_SCHEDULED_JOBS=false

# Clicker tuning and debug flags
CLICKER_DEBUG=false
CLICKER_ENERGY_REGEN_PER_SEC=1
CLICKER_AUTO_CLICKER_IDLE_THRESHOLD_SEC=60
CLICKER_AUTO_CLICKER_MAX_IDLE_SEC=3600

# Auth debug
AUTH_DEBUG=false
