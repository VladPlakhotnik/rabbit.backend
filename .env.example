# Backend environment variables — copy to `.env` and fill in real values.
# Never commit a populated `.env`.

# --- Core ---
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PORT=5000

# 64+ random hex chars. Generate with: openssl rand -hex 64
JWT_SECRET=replace_me_64_random_hex_chars

# Postgres connection string (Heroku DATABASE_URL or local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Redis (LiveDrop feed + Pub/Sub) ---
# Heroku Redis Cloud addon exposes REDISCLOUD_URL automatically;
# the app falls back to that if REDIS_URL is unset.
REDIS_URL=redis://localhost:6379

# --- CORS allowlist (comma-separated, no trailing slashes) ---
# REQUIRED in production; falls back to localhost variants in dev.
# Add your LAN IP (e.g. https://192.168.x.x) when testing from other devices.
# Both `https://host` and `https://host:443` may be needed because some
# browsers omit default-port from the Origin header and others include it.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,https://localhost:443

# --- LiveDrop bots ---
# Set to "true" to disable fake bot drops (e.g. for E2E tests).
DISABLE_BOTS=false

# --- Third-party API keys ---
STEAM_API_KEY=replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# market.csgo.com — bulk prices (free, no auth) + buy-for endpoint (requires key).
MARKET_CSGO_API_KEY=replace_me

# market.dota2.net — same operator (TM) as market.csgo.com, mirrored API.
# Get a key at market.dota2.net → account → API.
MARKET_DOTA2_API_KEY=replace_me

# DMarket — used as secondary metadata enrichment source for skins
# (image, quality, exterior, item_type, collection, name_color, etc.).
# Generate keys at DMarket → account → API. The secret key is shown
# only once at creation time — store it carefully.
DMARKET_API_KEY=replace_me
DMARKET_SECRET_KEY=replace_me

# --- Telegram bot integration ---
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHANNEL_CHAT_ID=replace_me
TELEGRAM_SUBSCRIPTION_BONUS_AMOUNT=1.00

# --- Google OAuth ---
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
