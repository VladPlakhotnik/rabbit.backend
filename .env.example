# Backend environment variables.
# Copy this file to `.env` and fill real values locally.
# Never commit a populated `.env`.

# Core
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Comma-separated allowlist, no trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://localhost,https://localhost:443,https://bunny.games

# Data stores
DATABASE_URL=postgres://user:password@localhost:5432/bunny
# Set to false for the local Docker database. Leave true for Neon.
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# Game-user JWT secrets. Use different values for access and refresh.
# Example generator:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_64_random_hex_chars
JWT_REFRESH_SECRET=replace_me_different_64_random_hex_chars

# Admin auth
ADMIN_JWT_ACCESS_SECRET=replace_me_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=replace_me_admin_refresh_secret
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=ChangeMeNow!2026
BCRYPT_ROUNDS=12
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_MAX_FAILED_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION_MS=900000
ADMIN_REFRESH_COOKIE_NAME=admin_rt

# Steam
STEAM_API_KEY=replace_me

# Google OAuth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Markets and pricing
MARKET_CSGO_API_KEY=replace_me
MARKET_DOTA2_API_KEY=replace_me
DMARKET_API_KEY=replace_me
DMARKET_SECRET_KEY=replace_me
SKIN_PRICE_MARKUP=0

# Skinsback skin deposits
SKINSBACK_API_URL=https://skinsback.com/api.php
SKINSBACK_TIMEOUT_MS=15000
SKINSBACK_CLIENT_ID=replace_me
SKINSBACK_CLIENT_SECRET=replace_me
SKINSBACK_CURRENCY=usd
# Must match the public backend URL configured in the SkinsBack merchant panel.
SKINSBACK_PUBLIC_BACKEND_URL=https://rabbit-backend.fly.dev
SKINSBACK_FRONTEND_URL=https://bunny.games
SKINSBACK_RESULT_URL=https://rabbit-backend.fly.dev/payment/skinsback/webhook
SKINSBACK_SUCCESS_URL=https://bunny.games/payment/history?tab=deposit&provider=skinsback&status=success
SKINSBACK_FAIL_URL=https://bunny.games/payment/history?tab=deposit&provider=skinsback&status=fail

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHANNEL_CHAT_ID=replace_me
TELEGRAM_SUBSCRIPTION_BONUS_AMOUNT=0.05

# Discord subscription bonus
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me
DISCORD_INVITE_URL=https://discord.gg/replace_me
DISCORD_OAUTH_REDIRECT_URL=http://localhost:5000/auth/discord/callback
DISCORD_SUBSCRIPTION_BONUS_AMOUNT=0.05

# Partnership / attribution
# Used to hash CPM visitor fingerprints server-side. Generate a random value:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARTNER_ATTRIBUTION_SALT=replace_me_random_hex

# Scheduled jobs and bots
# Master switch: disables all cron jobs and autonomous bot loops while
# keeping the HTTP API, authentication, and on-demand requests available.
DISABLE_BACKGROUND_JOBS=false
DISABLE_BOTS=false
DISABLE_MINES_BOTS=false
DISABLE_SCHEDULED_JOBS=false

# Clicker tuning and debug flags
CLICKER_DEBUG=false
CLICKER_ENERGY_REGEN_PER_SEC=1
CLICKER_AUTO_CLICKER_IDLE_THRESHOLD_SEC=60
# Dev/test only. Ignored unless CLICKER_ENABLE_LOCAL_AUTO_CLICKER_OVERRIDE=true.
# 0 means use DB tier duration_sec.
CLICKER_ENABLE_LOCAL_AUTO_CLICKER_OVERRIDE=false
CLICKER_AUTO_CLICKER_MAX_IDLE_SEC=0

# Auth debug
AUTH_DEBUG=false
